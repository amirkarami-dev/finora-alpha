    {
      "id": "aLmgRhYqNr6LJkvMge_6z",
      "type": "text",
      "x": 864.1396484375,
      "y": 347.16668701171875,
      "width": 403.720703125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
