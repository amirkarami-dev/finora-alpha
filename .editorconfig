root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml,md}]
indent_size = 2

[*.cs]
indent_size = 4
# File-scoped namespaces and `var` where the type is already on the line — the style the
# codebase is written in, so `dotnet format` agrees with what is already committed.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_namespace_match_folder = true:suggestion

[*.{csproj,props,targets,slnx}]
indent_size = 2
